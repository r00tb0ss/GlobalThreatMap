[Unit]
Description=Global Threat Intelligence Platform (dashboard, API, collectors)
Documentation=file:///opt/global-threat-intel/current/docs/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=gti
Group=gti
# read-only access to the system journal for the local sensor (SSH failures, UFW blocks)
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/global-threat-intel/gti.env
Environment=GTI_HOME=/opt/global-threat-intel/current
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/global-threat-intel/current
ExecStart=/opt/global-threat-intel/current/venv/bin/python -I -c "import sys; sys.path.insert(0, '/opt/global-threat-intel/current/backend'); from gti.app import main; main()"
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=20
# Resource limits: MemoryMax/MemoryHigh are set per hardware profile in
# /etc/systemd/system/global-threat-intel.service.d/10-resources.conf (written by install.sh).
TasksMax=128
# per-service network byte counters (shown by `gti health`)
IPAccounting=yes
LimitNOFILE=4096
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/global-threat-intel
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
