# Global Threat Intelligence Platform configuration.
# Created by install.sh. Preserved across updates and standard uninstall.
# After editing: sudo systemctl restart global-threat-intel
#
# Hardware profile detected at install time: @PROFILE@ (@MEM_MB@ MB RAM)

# Network. 0.0.0.0 = reachable from your LAN (login required). 127.0.0.1 = this machine only.
GTI_HOST=@HOST@
GTI_PORT=@PORT@

# Storage locations (do not change after install unless you move the files too).
GTI_DATA_DIR=/var/lib/global-threat-intel
GTI_GEOIP_DIR=/var/lib/global-threat-intel/geoip
GTI_FRONTEND_DIR=/opt/global-threat-intel/current/frontend

# Ingestion limits (sized for this hardware). Higher values use more RAM, CPU and disk.
GTI_MAX_INDICATORS_PER_SOURCE=@CAP@
GTI_MAX_EVENTS_PER_RUN=@EVENTS@
GTI_WS_MAX_CLIENTS=20

# Default retention in days (can be changed in the dashboard under Settings).
GTI_RETENTION_DAYS=30

# Set to 1 only when the dashboard is served over HTTPS (e.g. behind a reverse proxy).
GTI_COOKIE_SECURE=0

# Set to 0 to stop all feed collection (dashboard keeps working on stored data).
GTI_COLLECTORS=1

# Automatic backups kept in /var/backups/global-threat-intel
GTI_BACKUP_KEEP=7

# Optional: URL of a release manifest (JSON) used by "gti update --check". Empty = manual updates only.
GTI_UPDATE_URL=

GTI_LOG_LEVEL=INFO
